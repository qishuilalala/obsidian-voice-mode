{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "voice-mode bench@1",
  "type": "object",
  "required": [
    "schema",
    "product",
    "version",
    "corpus",
    "env",
    "metrics",
    "gate"
  ],
  "properties": {
    "schema": {
      "const": "voice-mode/bench@1"
    },
    "product": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "corpus": {
      "type": "string"
    },
    "env": {
      "type": "object",
      "required": [
        "os",
        "arch",
        "cpu",
        "memGB",
        "node",
        "host",
        "modelId",
        "warm",
        "corpusId",
        "segmentation",
        "gitSha",
        "timestamp"
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "expression": {
          "type": "object",
          "required": [
            "status",
            "scale",
            "dimensions"
          ]
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "mode",
        "result"
      ],
      "properties": {
        "mode": {
          "enum": [
            "report-only",
            "enforce"
          ]
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
